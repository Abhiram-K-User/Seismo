# Settings read from the ENVIRONMENT by the project (src/seismic_ml/paths.py).
# `.env` itself is NOT loaded automatically: export these in your shell, set them
# in your IDE run configuration, or set os.environ[...] in a notebook / Colab.
# Never commit a real `.env`.
#
# Precedence for storage locations (first match wins):
#   --data-root / --output-root flag  >  these variables  >  configs/config.yaml

# Root holding raw/ interim/ processed/  (default: <project>/data)
# Colab example: /content/drive/MyDrive/seismic-data
SEISMIC_DATA_ROOT=

# Root holding checkpoints/ logs/ figures/ results/  (default: <project>/outputs)
SEISMIC_OUTPUT_ROOT=

# GPU selection (empty = let PyTorch decide)
CUDA_VISIBLE_DEVICES=
